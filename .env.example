# Copy to .env and fill in. .env is git-ignored -- never commit real values.

# ---- Flask app (local run / docker compose) ----
APP_ENV=development
HOST=0.0.0.0
PORT=5000

# ---- AWS credentials (Terraform, scripts/deploy.sh, scripts/setup-github-secrets.sh) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary credentials
AWS_REGION=us-east-1
PROJECT_NAME=devops-challenge

# ---- Optional: OIDC instead of access keys in GitHub Actions ----
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/github-actions-deploy

# ---- GitHub repo the secrets are written to ----
GITHUB_REPO=varung0477-art/flask-app
